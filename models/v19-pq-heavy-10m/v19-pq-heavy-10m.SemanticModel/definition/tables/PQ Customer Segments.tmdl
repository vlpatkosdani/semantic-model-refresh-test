	partition 'PQ Customer Segments' = m
		mode: import
		source =
				let
				    // Merge every sales line with its customer, then group with distinct counts
				    Source = #"src Sales Heavy",
				    #"Merged Customer" = Table.NestedJoin(Source, {"CustomerKey"}, #"src Customer Heavy", {"CustomerKey"}, "C", JoinKind.LeftOuter),
				    #"Expanded Customer" = Table.ExpandTableColumn(#"Merged Customer", "C", {"Gender", "CountryFull", "Age"}, {"Gender", "Country", "Age"}),
				    #"Added Age Band" = Table.AddColumn(#"Expanded Customer", "Age Band", each if [Age] = null then "Unknown" else Text.From(Number.IntegerDivide([Age], 10) * 10) & "s", type text),
				    #"Added Year" = Table.AddColumn(#"Added Age Band", "Year", each Date.Year([OrderDate]), Int64.Type),
				    #"Grouped Rows" = Table.Group(#"Added Year", {"Country", "Gender", "Age Band", "Year"}, {
				        {"Sales Amount", each List.Sum([Amount]), type number},
				        {"Customers", each List.Count(List.Distinct([CustomerKey])), Int64.Type},
				        {"Orders", each List.Count(List.Distinct([OrderKey])), Int64.Type}})
				in
				    #"Grouped Rows"

	annotation PBI_ResultType = Table
