	partition 'PQ Delivery Days' = m
		mode: import
		source =
				let
				    // Join every order line with its order header (23.5M x 9.8M on 10M), then group by store and delivery time
				    Source = #"src OrderRows Heavy",
				    #"Merged Orders" = Table.NestedJoin(Source, {"OrderKey"}, #"src Orders Heavy", {"OrderKey"}, "O", JoinKind.Inner),
				    #"Expanded Orders" = Table.ExpandTableColumn(#"Merged Orders", "O", {"StoreKey", "DT", "DeliveryDate"}),
				    #"Added Delivery Days" = Table.AddColumn(#"Expanded Orders", "Delivery Days", each Duration.Days([DeliveryDate] - [DT]), Int64.Type),
				    #"Added Amount" = Table.AddColumn(#"Added Delivery Days", "Amount", each [Quantity] * [NetPrice], type number),
				    #"Grouped Rows" = Table.Group(#"Added Amount", {"StoreKey", "Delivery Days"}, {
				        {"Lines", each Table.RowCount(_), Int64.Type},
				        {"Net Amount", each List.Sum([Amount]), type number}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Grouped Rows", {{"StoreKey", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
