	partition 'PQ Customer RFM' = m
		mode: import
		source =
				let
				    // Recency, frequency, monetary per customer, ranked into quintiles, summarised per RFM segment
				    Source = #"src Sales Heavy",
				    #"Per Customer" = Table.Group(Source, {"CustomerKey"}, {
				        {"Last Order", each List.Max([OrderDate]), type datetime},
				        {"Frequency", each List.Count(List.Distinct([OrderKey])), Int64.Type},
				        {"Monetary", each List.Sum([Amount]), type number}}),
				    // Counting the customers evaluates the whole grouping a second time
				    CustomerCount = Table.RowCount(#"Per Customer"),
				    #"Ranked R" = Table.AddRankColumn(#"Per Customer", "R Rank", {"Last Order", Order.Descending}),
				    #"Ranked F" = Table.AddRankColumn(#"Ranked R", "F Rank", {"Frequency", Order.Descending}),
				    #"Ranked M" = Table.AddRankColumn(#"Ranked F", "M Rank", {"Monetary", Order.Descending}),
				    #"Added R" = Table.AddColumn(#"Ranked M", "R", each 5 - Number.IntegerDivide(([R Rank] - 1) * 5, CustomerCount), Int64.Type),
				    #"Added F" = Table.AddColumn(#"Added R", "F", each 5 - Number.IntegerDivide(([F Rank] - 1) * 5, CustomerCount), Int64.Type),
				    #"Added M" = Table.AddColumn(#"Added F", "M", each 5 - Number.IntegerDivide(([M Rank] - 1) * 5, CustomerCount), Int64.Type),
				    #"Added Segment" = Table.AddColumn(#"Added M", "RFM Segment", each Text.From([R]) & Text.From([F]) & Text.From([M]), type text),
				    #"Grouped Rows" = Table.Group(#"Added Segment", {"RFM Segment", "R", "F", "M"}, {
				        {"Customers", each Table.RowCount(_), Int64.Type},
				        {"Monetary", each List.Sum([Monetary]), type number}})
				in
				    #"Grouped Rows"

	annotation PBI_ResultType = Table
