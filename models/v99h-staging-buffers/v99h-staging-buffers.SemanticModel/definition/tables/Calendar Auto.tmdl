		isDataTypeInferred
		sourceColumn: [Month]

		annotation SummarizationSetBy = Automatic

	partition 'Calendar Auto' = calculated
		mode: import
		source =
				// ANTIPATTERN: second date table from CALENDARAUTO. Its range comes from every date column in the model (customer birthdays go back decades).
				ADDCOLUMNS (
				    CALENDARAUTO (),
				    "Year", YEAR ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm yyyy" )
				)
