table 'Customer Segment'
	lineageTag: 3acbfe79-70ed-49c0-9ba7-e1ccb3593af0

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7adc4d2c-7b10-4581-bbd1-6111f8a66254
		summarizeBy: none
		sourceColumn: CustomerKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: c47e5830-9c22-430b-98ce-733525a05d48
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column Segment
		dataType: string
		lineageTag: 8cca67d7-ad92-441b-a430-0adaa565b817
		summarizeBy: none
		sourceColumn: Segment

		annotation SummarizationSetBy = Automatic

	partition 'Customer Segment-dbaeade0-9f07-402d-9d2e-42c32fdcb637' = m
		mode: import
		source =
				let
				    Source = fnLoadParquet("customer.parquet"),
				    Keys = Table.SelectColumns(Source, {"CustomerKey"}),
				    WithYear = Table.AddColumn(Keys, "Year", each {2016..2025}),
				    Expanded = Table.ExpandListColumn(WithYear, "Year"),
				    // Synthetic segments: each customer changes segment every four years (2016-2019, 2020-2023, 2024-2025)
				    WithSegment = Table.AddColumn(Expanded, "Segment", each {"Bronze", "Silver", "Gold"}{Number.Mod([CustomerKey] + Number.IntegerDivide([Year] - 2016, 4), 3)}),
				    #"Changed Type" = Table.TransformColumnTypes(WithSegment, {{"CustomerKey", Int64.Type}, {"Year", Int64.Type}, {"Segment", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
