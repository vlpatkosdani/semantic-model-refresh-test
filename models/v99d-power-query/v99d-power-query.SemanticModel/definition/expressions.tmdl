expression 'Unused Heavy Query' =
		let
		    Rows = fnLoadParquet("orderrows.parquet"),
		    Orders = fnLoadParquet("orders.parquet"),
		    Merged = Table.NestedJoin(Rows, {"OrderKey"}, Orders, {"OrderKey"}, "Order", JoinKind.Inner),
		    Expanded = Table.ExpandTableColumn(Merged, "Order", {"CustomerKey", "StoreKey", "DT", "CurrencyCode"}),
		    Sorted = Table.Sort(Expanded, {{"NetPrice", Order.Descending}, {"OrderKey", Order.Ascending}}),
		    Buffered = Table.Buffer(Sorted),
		    Grouped = Table.Group(Buffered, {"CustomerKey", "StoreKey"}, {{"Lines", each Table.RowCount(_), Int64.Type}, {"Net Price", each List.Sum([NetPrice]), type number}})
		in
		    Grouped
	lineageTag: ad083aed-c967-4a2d-8518-177c388d5c5a

	annotation PBI_ResultType = Table

