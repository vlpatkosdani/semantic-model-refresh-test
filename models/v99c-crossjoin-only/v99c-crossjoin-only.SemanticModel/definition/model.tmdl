model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["stg Sales","stg Customer","stg Product","stg Store","stg Date","Customer","Date","Product","Sales","Store","Currency Exchange","Sales Flat","Customer Stats","Unused Heavy Query","DataTag","fnLoadParquet"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customer
ref table Date
ref table Product
ref table Sales
ref table Store
ref table 'Currency Exchange'
ref table 'Sales Flat'
ref table 'Customer Stats'
ref table 'Sales Copy'
ref table 'Sales Summary'
ref table 'Product Date Grid'
ref table 'Calendar Auto'

ref cultureInfo en-US

