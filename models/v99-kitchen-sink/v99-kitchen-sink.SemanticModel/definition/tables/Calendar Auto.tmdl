table 'Calendar Auto'
	lineageTag: d834353a-87cb-49b9-9574-989aabab40d7

	column Date
		dataType: dateTime
		isNameInferred
		lineageTag: ed59c3e5-f3ae-44a6-a3d6-72d50d8d3b29
		summarizeBy: none
