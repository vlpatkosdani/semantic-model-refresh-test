		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		isNameInferred
		lineageTag: 5db33874-5a57-41dd-bca2-c6589b98408d
		summarizeBy: none
		isDataTypeInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		isNameInferred
		lineageTag: 1b46c725-ba57-41c1-a523-c94026a05712
		summarizeBy: none
		isDataTypeInferred
		sourceColumn: [Month]

		annotation SummarizationSetBy = Automatic

	partition 'Calendar Auto' = calculated
		mode: import
		source =
				// ANTIPATTERN: second date table from CALENDARAUTO. Its range comes from every date column in the model (customer birthdays go back decades).
				ADDCOLUMNS (
				    CALENDARAUTO (),
				    "Year", YEAR ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm yyyy" )
				)
