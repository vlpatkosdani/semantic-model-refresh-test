table 'Sales Copy'
	lineageTag: d7571100-221f-4507-89a3-71b5eedecdc0

	partition 'Sales Copy' = calculated
		mode: import
		source =
				// ANTIPATTERN: full copy of Sales with all its columns, plus six RELATED columns.
				// ===== KNOB: CopyCount = number of copies of the Sales rows. 1 copy = 2.35M rows on the 1M data, 23.5M on the 10M data. =====
				VAR CopyCount = 4
				RETURN
				    GENERATE (
				        ADDCOLUMNS (
				            Sales,
				            "Customer City", RELATED ( Customer[City] ),
				            "Customer Continent", RELATED ( Customer[Continent] ),
				            "Product Brand", RELATED ( 'Product'[Brand] ),
				            "Product Subcategory", RELATED ( 'Product'[Subcategory] ),
				            "Store Country", RELATED ( Store[Country] ),
				            "Order Year", RELATED ( 'Date'[Year] )
				        ),
				        SELECTCOLUMNS ( GENERATESERIES ( 1, CopyCount ), "Copy Number", [Value] )
				    )
