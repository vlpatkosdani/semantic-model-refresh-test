	partition 'Customer Stats' = m
		mode: import
		source =
				let
				    // ANTIPATTERN: Group By over the full fact in Power Query. CustomerKey repeats once per year, so the relationship to Sales is many-to-many.
				    Source = #"stg Sales",
				    #"Buffered Rows" = Table.Buffer(Source),
				    #"Added Year" = Table.AddColumn(#"Buffered Rows", "Year", each Date.Year(DateTime.FromText([OrderDate], "en-US")), Int64.Type),
				    #"Grouped Rows" = Table.Group(#"Added Year", {"CustomerKey", "Year"}, {
				        {"Orders", each List.Count(List.Distinct([OrderKey])), Int64.Type},
				        {"Lines", each Table.RowCount(_), Int64.Type},
				        {"Sales Amount", each List.Sum(List.Transform(Table.ToRows(Table.SelectColumns(_, {"Quantity", "NetPrice"})), (r) => Number.From(r{0}, "en-US") * Number.From(r{1}, "en-US"))), type number}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Grouped Rows", {{"CustomerKey", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

