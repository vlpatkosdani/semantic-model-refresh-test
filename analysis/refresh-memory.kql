// Refresh memory analysis for the semantic model refresh lab.
//
// For Fabric workspace monitoring: the SemanticModelLogs table in the
// "Monitoring KQL database" of the F64 lab workspace. The F2 workspace has no
// monitoring (F2 cannot carry the monitoring Eventhouse), so its results come
// from the error messages and are recorded by hand in the model READMEs.
//
// Every model in the lab refreshes on F64, so these logs give the real peak of
// each model. In all runs so far, a peak above the F2 limit (about 3,066 MB)
// has meant a failure on F2, and a peak below it a successful refresh.
//
// Paste this file into a KQL queryset connected to the Monitoring KQL database,
// put the cursor in one query and press Run. Each query stands on its own and
// needs no input.
//
// How a refresh is found: its ExecutionMetrics event has tabularConnectionTimeoutMs
// in it. The many small metadata and discover commands around a refresh have
// ExecutionMetrics too, but without that field and with a peak of 0. Queries 3
// and 4 take the progress events of the same model between timeStart and timeEnd
// of that refresh.


// ---------------------------------------------------------------------------
// 1. One row per refresh: model, result, peak memory, duration, CPU
// ---------------------------------------------------------------------------
// errorCount > 0 marks a failed refresh. For a refresh cancelled by resource
// governance, the peak is where the engine stopped it, a lower bound.
// MEnginePeakMB is the Power Query (mashup engine) part of the peak.
let F2LimitMB = 3066;
SemanticModelLogs
| where Timestamp > ago(30d) and OperationName == "ExecutionMetrics"
| extend m = parse_json(EventText)
| where isnotnull(m.tabularConnectionTimeoutMs)
| project Timestamp, Model = ItemName,
          Result         = iff(toint(m.errorCount) > 0, "failed", "refreshed"),
          PeakMemMB      = round(todouble(m.approximatePeakMemConsumptionKB) / 1024, 0),
          MEnginePeakMB  = round(todouble(m.mEnginePeakMemoryKB) / 1024, 0),
          DurationMin    = round(todouble(m.durationMs) / 60000, 1),
          TotalCpuSec    = round(todouble(m.totalCpuTimeMs) / 1000, 0),
          MEngineCpuSec  = round(todouble(m.mEngineCpuTimeMs) / 1000, 0),
          VertipaqCpuSec = round(todouble(m.vertipaqJobCpuTimeMs) / 1000, 0),
          RowsLoaded     = tolong(m.vertipaqTotalRows)
| extend PeakVsF2 = round(PeakMemMB / F2LimitMB, 2)
| order by Model asc, Timestamp desc


// ---------------------------------------------------------------------------
// 2. Compare models: latest refresh of each model, as a chart
// ---------------------------------------------------------------------------
// Total peak and its Power Query part side by side. A total above about
// 3,066 MB predicts a failure on F2. For failed refreshes the bar is where the
// engine cancelled, not the full peak.
SemanticModelLogs
| where Timestamp > ago(30d) and OperationName == "ExecutionMetrics"
| extend m = parse_json(EventText)
| where isnotnull(m.tabularConnectionTimeoutMs)
| summarize arg_max(Timestamp, m) by Model = ItemName
| project Label = strcat(Model, iff(toint(m.errorCount) > 0, " (failed)", "")),
          PeakMemMB = round(todouble(m.approximatePeakMemConsumptionKB) / 1024, 0),
          PowerQueryMB = round(todouble(m.mEnginePeakMemoryKB) / 1024, 0)
| order by Label asc
| render barchart with (title = "Peak refresh memory on F64, latest refresh per model", xtitle = "", ytitle = "MB")


// ---------------------------------------------------------------------------
// 3. Time and rows per table, latest refresh of every model
// ---------------------------------------------------------------------------
// One row per model, object (table and partition) and step. ReadData is the
// time Power Query spent delivering the rows of a partition. The other steps
// (CompressSegment, VertiPaq, calculated columns, relationships) are engine
// work. Add `| where OperationDetailName == "ReadData"` at the end to keep only
// the Power Query side, or `| where Model == "v20-pq-sort"` for one model.
let Refreshes = SemanticModelLogs
| where Timestamp > ago(30d) and OperationName == "ExecutionMetrics"
| extend m = parse_json(EventText)
| where isnotnull(m.tabularConnectionTimeoutMs)
| summarize arg_max(Timestamp, m) by Model = ItemName
| project Model, Start = todatetime(m.timeStart), End = todatetime(m.timeEnd) + 5s,
          Result = iff(toint(m.errorCount) > 0, "failed", "refreshed");
SemanticModelLogs
| where Timestamp > ago(30d) and OperationName == "ProgressReportEnd"
| project Timestamp, Model = ItemName, OperationDetailName, XmlaObjectPath, DurationMs, CpuTimeMs, ProgressCounter
| join kind=inner Refreshes on Model
| where Timestamp between (Start .. End)
| extend Object = strcat_array(array_slice(split(XmlaObjectPath, "."), -2, -1), ".")
| summarize DurationSec = round(sum(DurationMs) / 1000.0, 1),
            CpuSec = round(sum(CpuTimeMs) / 1000.0, 1),
            Rows = max(ProgressCounter)
  by Model, Result, Object, OperationDetailName
| order by Model asc, DurationSec desc


// ---------------------------------------------------------------------------
// 4. What was running when a refresh failed, every failed refresh
// ---------------------------------------------------------------------------
// For each failed refresh on this capacity (v99, v99d, v99h and v99i on F64),
// the steps that began but never ended, or ended with an error. These are the
// tables that were being read or processed when the engine cancelled.
let Failed = SemanticModelLogs
| where Timestamp > ago(30d) and OperationName == "ExecutionMetrics"
| extend m = parse_json(EventText)
| where isnotnull(m.tabularConnectionTimeoutMs) and toint(m.errorCount) > 0
| project Model = ItemName, RefreshEnd = Timestamp,
          Start = todatetime(m.timeStart), End = todatetime(m.timeEnd) + 5s;
SemanticModelLogs
| where Timestamp > ago(30d) and OperationName in ("ProgressReportBegin", "ProgressReportEnd")
| project Timestamp, Model = ItemName, OperationName, OperationDetailName, XmlaObjectPath, Status
| join kind=inner Failed on Model
| where Timestamp between (Start .. End)
| summarize Began     = minif(Timestamp, OperationName == "ProgressReportBegin"),
            Ended     = maxif(Timestamp, OperationName == "ProgressReportEnd"),
            EndStatus = take_anyif(Status, OperationName == "ProgressReportEnd")
  by Model, RefreshEnd, XmlaObjectPath, OperationDetailName
| where isnull(Ended) or EndStatus != "Succeeded"
| extend Object = strcat_array(array_slice(split(XmlaObjectPath, "."), -2, -1), ".")
| project Model, RefreshEnd, Object, OperationDetailName, Began, Ended, EndStatus
| order by Model asc, RefreshEnd desc, Began asc
