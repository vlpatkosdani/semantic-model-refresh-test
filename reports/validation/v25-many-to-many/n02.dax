// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"Gold"}, 'Customer Segment'[Segment])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS('Date'[Year], __DS0FilterTable, "Sales_Amount", 'Sales'[Sales Amount])

	VAR __DS0BodyLimited = 
		SAMPLE(3502, __DS0Core, 'Date'[Year], 1)

EVALUATE
	__DS0BodyLimited

ORDER BY
	'Date'[Year]
