// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"Gold"}, 'Customer Segment'[Segment])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP('Product'[Category], 'Product'[Category Code]), "IsGrandTotalRowTotal"
			),
			__DS0FilterTable,
			"Sales_Amount", 'Sales'[Sales Amount],
			"v__Orders", 'Sales'[# Orders]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(
			502,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'Product'[Category Code],
			1,
			'Product'[Category],
			1
		)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'Product'[Category Code], 'Product'[Category]
