// DAX Query
DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL('Customer'[Country], "IsGrandTotalRowTotal"),
			"Sales_Amount", 'Sales'[Sales Amount],
			"Margin", 'Sales'[Margin],
			"v__Orders", 'Sales'[# Orders]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, 'Customer'[Country], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'Customer'[Country]
