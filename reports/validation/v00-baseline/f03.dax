// Captured in Desktop with "TV and Video" selected in the Category slicer; the value is replaced by "Computers", the spec selection.
// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"Computers"}, 'Product'[Category])

	VAR __DS0FilterTable2 = 
		TREATAS({"Germany"}, 'Customer'[Country])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Product'[Brand],
			__DS0FilterTable,
			__DS0FilterTable2,
			"Sales_Amount", 'Sales'[Sales Amount]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(1001, __DS0Core, 'Product'[Brand], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Product'[Brand]
