// DAX Query
DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP('Product'[Subcategory], 'Product'[Subcategory Code]), "IsGrandTotalRowTotal"
			),
			"Sales_Amount", 'Sales'[Sales Amount],
			"Total_Quantity", 'Sales'[Total Quantity]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(
			502,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'Product'[Subcategory Code],
			1,
			'Product'[Subcategory],
			1
		)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'Product'[Subcategory Code], 'Product'[Subcategory]
