// DAX Query
DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Product'[Category],
			'Product'[Category Code],
			"Sales_Amount", 'Sales'[Sales Amount]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(1001, __DS0Core, 'Product'[Category Code], 1, 'Product'[Category], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Product'[Category Code], 'Product'[Category]
