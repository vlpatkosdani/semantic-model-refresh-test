// DAX Query
DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Date'[Year Month],
			'Date'[Year Month Number],
			"Sales_Amount", 'Sales'[Sales Amount]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(1001, __DS0Core, 'Date'[Year Month Number], 1, 'Date'[Year Month], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Date'[Year Month Number], 'Date'[Year Month]
