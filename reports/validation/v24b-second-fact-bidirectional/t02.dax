// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"Computers"}, 'Product'[Category])

	VAR __DS0Core = 
		CALCULATETABLE(
			VALUES('Customer'[Country]),
			KEEPFILTERS(__DS0FilterTable)
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(101, __DS0Core, 'Customer'[Country], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Customer'[Country]
