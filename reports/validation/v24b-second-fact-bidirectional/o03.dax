// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"Germany"}, 'Customer'[Country])

	VAR __DS0FilterTable2 = 
		TREATAS({"Computers"}, 'Product'[Category])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL('Store'[Name], "IsGrandTotalRowTotal"),
			__DS0FilterTable,
			__DS0FilterTable2,
			"Order_Count", 'Orders'[Order Count],
			"Sales_Amount", 'Sales'[Sales Amount]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, 'Store'[Name], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'Store'[Name]
