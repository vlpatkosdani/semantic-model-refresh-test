// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"Germany"}, 'Customer'[Country])

	VAR __DS0Core = 
		CALCULATETABLE(
			SUMMARIZE(VALUES('Product'), 'Product'[Category], 'Product'[Category Code]),
			KEEPFILTERS(__DS0FilterTable)
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(101, __DS0Core, 'Product'[Category Code], 1, 'Product'[Category], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Product'[Category Code], 'Product'[Category]
