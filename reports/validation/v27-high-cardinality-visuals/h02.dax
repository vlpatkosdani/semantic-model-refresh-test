// DAX Query
DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(ROLLUPGROUP('Customer'[Name], 'Customer'[City]), "IsGrandTotalRowTotal"),
			"Sales_Amount", 'Sales'[Sales Amount],
			"v__Orders", 'Sales'[# Orders]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, 'Customer'[Name], 1, 'Customer'[City], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'Customer'[Name], 'Customer'[City]
