// DAX Query
DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP('Sales'[Order Number], 'Sales'[Line Number], 'Product'[Product Name]), "IsGrandTotalRowTotal"
			),
			"Sales_Amount", 'Sales'[Sales Amount]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(
			502,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'Sales'[Order Number],
			1,
			'Sales'[Line Number],
			1,
			'Product'[Product Name],
			1
		)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'Sales'[Order Number],
	'Sales'[Line Number],
	'Product'[Product Name]
