// DAX Query
DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL('Sales'[Order Number], "IsGrandTotalRowTotal"),
			"Sales_Amount", 'Sales'[Sales Amount],
			"Total_Quantity", 'Sales'[Total Quantity]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, 'Sales'[Order Number], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'Sales'[Order Number]
